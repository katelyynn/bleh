{
	"$schema": "https://raw.githubusercontent.com/denoland/deno/refs/heads/main/cli/schemas/config-file.v1.json",
	"imports": {
		"@/": "./src/",
		"@deno/esbuild-plugin": "jsr:@deno/esbuild-plugin@^1.2.1",
		"@fontsource-variable/atkinson-hyperlegible-next": "npm:@fontsource-variable/atkinson-hyperlegible-next@^5.3.0",
		"@fontsource-variable/bitcount-grid-single": "npm:@fontsource-variable/bitcount-grid-single@^5.3.0",
		"@fontsource-variable/funnel-sans": "npm:@fontsource-variable/funnel-sans@^5.3.0",
		"@fontsource-variable/google-sans-code": "npm:@fontsource-variable/google-sans-code@^5.3.0",
		"@fontsource-variable/hanken-grotesk": "npm:@fontsource-variable/hanken-grotesk@^5.3.0",
		"@fontsource-variable/inconsolata": "npm:@fontsource-variable/inconsolata@^5.3.0",
		"@fontsource-variable/noto-sans-jp": "npm:@fontsource-variable/noto-sans-jp@^5.3.0",
		"@fontsource-variable/noto-sans-kr": "npm:@fontsource-variable/noto-sans-kr@^5.3.0",
		"@fontsource-variable/noto-sans-tc": "npm:@fontsource-variable/noto-sans-tc@^5.3.0",
		"@fontsource-variable/rokkitt": "npm:@fontsource-variable/rokkitt@^5.3.0",
		"@fontsource/balsamiq-sans": "npm:@fontsource/balsamiq-sans@^5.3.0",
		"@fontsource/cherry-bomb-one": "npm:@fontsource/cherry-bomb-one@^5.3.0",
		"@fontsource/crimson-text": "npm:@fontsource/crimson-text@^5.3.0",
		"@fontsource/darumadrop-one": "npm:@fontsource/darumadrop-one@^5.3.0",
		"@fontsource/instrument-serif": "npm:@fontsource/instrument-serif@^5.3.0",
		"@fontsource/lilita-one": "npm:@fontsource/lilita-one@^5.3.0",
		"@fontsource/noto-color-emoji": "npm:@fontsource/noto-color-emoji@^5.3.0",
		"@fontsource/rakkas": "npm:@fontsource/rakkas@^5.3.0",
		"@fontsource/single-day": "npm:@fontsource/single-day@^5.3.0",
		"@fontsource/unifrakturcook": "npm:@fontsource/unifrakturcook@^5.3.0",
		"@std/fmt": "jsr:@std/fmt@^1.0.10",
		"@std/fs": "jsr:@std/fs@^1.0.24",
		"@std/http": "jsr:@std/http@^1.1.2",
		"@tealmiku/florence": "npm:@tealmiku/florence@^2026.527.0",
		"@types/luxon": "npm:@types/luxon@^3.7.3",
		"@zachleat/hypercard": "npm:@zachleat/hypercard@^2.0.2",
		"chart.js": "npm:chart.js@^4.5.1",
		"chartjs-adapter-luxon": "npm:chartjs-adapter-luxon@^1.3.1",
		"chartjs-plugin-zoom": "npm:chartjs-plugin-zoom@^2.2.0",
		"color-namer": "npm:color-namer@^1.4.0",
		"countup.js": "npm:countup.js@^2.10.1",
		"cropperjs": "npm:cropperjs@^1.6.2",
		"cssnano": "npm:cssnano@^7.1.9",
		"culori": "npm:culori@^4.0.2",
		"dompurify": "npm:dompurify@^3.4.12",
		"esbuild": "npm:esbuild@^0.28.1",
		"fast-average-color": "npm:fast-average-color@^9.5.2",
		"hangul-js": "npm:hangul-js@^0.2.6",
		"hangul-romanization": "npm:hangul-romanization@^1.0.1",
		"html2canvas-pro": "npm:html2canvas-pro@^1.6.7",
		"json5": "npm:json5@^2.2.3",
		"jsx-dom": "npm:jsx-dom@^8.1.6",
		"lighterhtml": "npm:lighterhtml@^4.2.0",
		"luxon": "npm:luxon@^3.7.2",
		"odometer_countup": "npm:odometer_countup@^1.0.4",
		"postcss": "npm:postcss@^8.5.25",
		"showdown": "npm:showdown@^2.1.0",
		"tippy.js": "npm:tippy.js@^6.3.7",
		"wanakana": "npm:wanakana@^5.3.1"
	},
	"tasks": {
		"build": "deno run -P index.ts",
		"dev": "deno run -P --watch=./src/ --watch-exclude=./src/build/build.json index.ts serve",
		"license": "deno fmt && deno run --allow-read --allow-write scripts/copyright.ts"
	},
	"permissions": {
		"default": {
			"read": true,
			"write": true,
			"run": true,
			"env": true,
			"net": [
				"0.0.0.0"
			]
		}
	},
	"compilerOptions": {
		"checkJs": true,
		"lib": [
			"deno.window",
			"deno.unstable",
			"deno.ns",
			"dom",
			"node",
			"esnext",
			"dom.iterable"
		],
		"module": "nodenext",
		"moduleResolution": "bundler",
		"jsx": "react-jsx",
		"jsxImportSource": "jsx-dom"
	},
	"fmt": {
		"singleQuote": true,
		"indentWidth": 4,
		"useTabs": true,
		"exclude": [
			"bleh.user.js",
			"bleh.user.css",
			"ext/*",
			"**/*.md"
		]
	},
	"lint": {
		"rules": {
			"exclude": [
				"no-sloppy-imports",
				"no-window"
			]
		},
		"exclude": [
			"bleh.user.js",
			"bleh.user.css",
			"ext/*",
			"**/*.md"
		]
	},
	"nodeModulesDir": "auto"
}
